---
const year = new Date().getFullYear();

const social = [
  { label: "Email", href: "mailto:build@defendableos.com" },
  { label: "Hugging Face", href: "https://huggingface.co/SwarmandBee" },
  { label: "X", href: "https://x.com/mrdefendable" },
  { label: "GitHub", href: "https://github.com/SudoSuOps" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/donovan-mackey-89a6063b6/" },
];

const ecosystem = [
  { label: "DefendableOS", href: "https://defendableos.com" },
  { label: "DefendableRouter", href: "https://defendablerouter.com" },
  { label: "DefendableDocs", href: "https://defendabledocs.com" },
  { label: "OpenDefendable", href: "https://opendefendable.com" },
  { label: "MrDefendable", href: "https://mrdefendable.com" },
];
---

<footer class="border-t border-white/5 bg-ink">
  <div class="mx-auto max-w-container px-6 py-12 text-center">
    <div class="flex flex-col items-center">
      <div class="flex items-center gap-2.5">
        <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true">
          <rect width="32" height="32" rx="6" fill="#0a0a0a" stroke="#e6ab2a" stroke-width="1" />
          <g
            fill="none"
            stroke="#f6c64b"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M8 6h12l4 4v16H8z" />
            <path d="M12 12h8M12 16h10M12 20h6" stroke-width="1.2" opacity="0.7" />
          </g>
        </svg>
        <span class="text-sm font-semibold tracking-tight text-paper">DefendableCloud</span>
      </div>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-paper/50">
        Hosted Proof of Execution for agentic work — create a run, attach evidence, run checks,
        approve, and issue a receipt you can store and share.
      </p>
    </div>

    <nav
      class="mt-10 flex flex-wrap justify-center gap-x-16 gap-y-8 text-sm"
      aria-label="Footer"
    >
      <ul class="space-y-2 text-paper/60">
        <li class="text-xs uppercase tracking-widest text-paper/35">DefendableCloud</li>
        <li><a class="hover:text-paper" href="/#run">The Run</a></li>
        <li><a class="hover:text-paper" href="/#how">How it works</a></li>
        <li><a class="hover:text-paper" href="/#lanes">Lanes</a></li>
        <li><a class="hover:text-paper" href="/#outputs">Receipts</a></li>
        <li><a class="hover:text-paper" href="/trust">Trust Center</a></li>
        <li><a class="hover:text-paper" href="/security">Security</a></li>
        <li><a class="hover:text-paper" href="/status">Status</a></li>
        <li><a class="hover:text-paper" href="/contact">Request access</a></li>
      </ul>
      <ul class="space-y-2 text-paper/60">
        <li class="text-xs uppercase tracking-widest text-paper/35">Ecosystem</li>
        {
          ecosystem.map((item) => (
            <li>
              <a
                class="hover:text-paper"
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="space-y-2 text-paper/60">
        <li class="text-xs uppercase tracking-widest text-paper/35">Connect</li>
        {
          social.map((item) => (
            <li>
              <a
                class="hover:text-paper"
                href={item.href}
                {...item.href.startsWith("http")
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {}}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="space-y-2 text-paper/60">
        <li class="text-xs uppercase tracking-widest text-paper/35">Legal</li>
        <li><a class="hover:text-paper" href="/legal/privacy">Privacy</a></li>
        <li><a class="hover:text-paper" href="/legal/terms">Terms</a></li>
        <li><a class="hover:text-paper" href="/legal/dpa">DPA</a></li>
        <li><a class="hover:text-paper" href="/sla">SLA</a></li>
        <li><a class="hover:text-paper" href="/geo">GEO</a></li>
      </ul>
    </nav>

    <div class="mt-10 flex flex-col items-center gap-2 border-t border-white/5 pt-6 text-xs text-paper/40">
      <p>Swarm and Bee LLC · DBA Swarm &amp; Bee AI · Florida · D-U-N-S 138652395</p>
      <p>&copy; {year} DefendableCloud · Swarm &amp; Bee. To the shed.</p>
    </div>
  </div>
</footer>
