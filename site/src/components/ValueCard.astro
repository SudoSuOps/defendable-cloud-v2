---
export interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<div
  class="reveal group h-full rounded-xl border border-white/8 bg-white/[0.02] p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-honey-400/30 hover:bg-white/[0.04]"
>
  <div class="flex items-center gap-2.5">
    <span
      class="h-1.5 w-1.5 rounded-full bg-honey-300 transition-shadow duration-300 group-hover:shadow-[0_0_10px_2px_rgba(246,198,75,0.5)]"
      aria-hidden="true"></span>
    <h3 class="text-base font-semibold text-paper">{title}</h3>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-paper/65">{body}</p>
</div>
