---
export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  class?: string;
}

const { id, eyebrow, title, intro, class: className = "" } = Astro.props;
---

<section id={id} class={`mx-auto max-w-container px-6 py-16 md:py-20 ${className}`}>
  {
    (eyebrow || title || intro) && (
      <div class="reveal mx-auto max-w-2xl text-center">
        {eyebrow && (
          <p class="text-sm font-medium uppercase tracking-widest text-honey-300">{eyebrow}</p>
        )}
        {title && (
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-paper md:text-4xl">
            {title}
          </h2>
        )}
        {intro && <p class="mt-4 text-lg leading-relaxed text-paper/70">{intro}</p>}
      </div>
    )
  }
  <slot />
</section>
