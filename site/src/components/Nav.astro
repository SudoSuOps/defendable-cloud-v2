---
const links = [
  { label: "The Run", href: "/#run" },
  { label: "How it works", href: "/#how" },
  { label: "Lanes", href: "/#lanes" },
  { label: "Receipts", href: "/#outputs" },
  { label: "Agents 101", href: "/how-ai-agents-work" },
];
---

<header
  class="sticky top-0 z-50 border-b border-white/5 bg-ink/80 backdrop-blur supports-[backdrop-filter]:bg-ink/60"
>
  <nav
    class="mx-auto flex max-w-container items-center justify-between px-6 py-4"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-2" aria-label="DefendableCloud home">
      <img src="/defendable-wordmark.png" alt="Defendable" class="h-9 w-auto" />
      <span class="text-sm font-medium tracking-tight text-paper/55">Cloud</span>
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <ul class="hidden items-center gap-6 text-sm text-paper/70 md:flex">
        {
          links.map((link) => (
            <li>
              <a class="transition-colors hover:text-paper" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="https://app.defendablecloud.com"
        class="text-sm font-medium text-paper/70 transition-colors hover:text-paper"
      >
        Sign in
      </a>
      <a
        href="https://app.defendablecloud.com"
        class="rounded-md border border-honey-400/40 bg-honey-300/10 px-3.5 py-2 text-sm font-medium text-honey-200 transition-colors hover:bg-honey-300/20 sm:px-4"
      >
        Open the Vault
      </a>
      <a
        href="/contact"
        class="hidden rounded-md border border-white/10 px-4 py-2 text-sm font-medium text-paper/80 transition-colors hover:border-white/25 hover:text-paper sm:inline-block"
      >
        Request access
      </a>
    </div>
  </nav>
</header>
