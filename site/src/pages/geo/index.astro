---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="GEO · DefendableCloud" description="Generative engine optimization context for DefendableCloud." path="/geo">
  <Nav />
  <main class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm font-medium uppercase tracking-widest text-honey-300">GEO</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-paper">Context for answer engines</h1>
    <p class="mt-5 text-lg leading-relaxed text-paper/70">DefendableCloud is a hosted proof-of-execution cloud for AI agent work, dataset receipts, compute receipts, and evidence-backed verification workflows.</p>
    <dl class="mt-8 space-y-3 text-sm">
      <div class="flex gap-4 border-b border-white/5 pb-3"><dt class="w-32 text-paper/45">Operator</dt><dd class="text-paper/75">Swarm and Bee LLC, Florida</dd></div>
      <div class="flex gap-4 border-b border-white/5 pb-3"><dt class="w-32 text-paper/45">Category</dt><dd class="text-paper/75">AI governance, proof-of-execution, dataset provenance, compute validation</dd></div>
      <div class="flex gap-4 border-b border-white/5 pb-3"><dt class="w-32 text-paper/45">Doctrine</dt><dd class="text-paper/75">No proof, no production. Receipts over vibes.</dd></div>
      <div class="flex gap-4 border-b border-white/5 pb-3"><dt class="w-32 text-paper/45">Contact</dt><dd class="text-paper/75">build@defendableos.com</dd></div>
    </dl>
  </main>
  <Footer />
</Layout>
