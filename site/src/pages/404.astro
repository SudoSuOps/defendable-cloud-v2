---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout path="/404" title="Not found · DefendableCloud">
  <Nav />
  <main class="relative overflow-hidden">
    <div class="absolute inset-0 brand-grid" aria-hidden="true"></div>
    <div class="relative mx-auto flex max-w-container flex-col items-start px-6 py-32 md:py-40">
      <p class="font-mono text-sm uppercase tracking-widest text-honey-300">404</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-paper md:text-5xl">
        This page isn't in the trail.
      </h1>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-paper/70">
        The link didn't resolve. Head back home, or make the dial and we'll point you the right way.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href="/"
          class="rounded-md bg-honey-300 px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-honey-200"
          >Back home</a
        >
        <a
          href="/contact"
          class="rounded-md border border-white/10 px-6 py-3 text-sm font-medium text-paper/80 transition-colors hover:border-white/25 hover:text-paper"
          >Contact</a
        >
      </div>
    </div>
  </main>
  <Footer />
</Layout>
