---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Privacy Policy · DefendableCloud" description="DefendableCloud privacy policy." path="/legal/privacy">
  <Nav />
  <main class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm font-medium uppercase tracking-widest text-honey-300">Legal</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-paper">Privacy Policy</h1>
    <p class="mt-5 text-sm leading-relaxed text-paper/65">DefendableCloud collects the minimum account, organization, payment, evidence, and operational metadata needed to provide proof, receipt, dataset access, and support services. We do not sell customer data. Contact build@defendableos.com for privacy requests.</p>
    <p class="mt-4 text-xs uppercase tracking-widest text-paper/35">Launch policy placeholder · replace with counsel-approved policy before enterprise contracts.</p>
  </main>
  <Footer />
</Layout>
