---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Terms · DefendableCloud" description="DefendableCloud terms of service." path="/legal/terms">
  <Nav />
  <main class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm font-medium uppercase tracking-widest text-honey-300">Legal</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-paper">Terms of Service</h1>
    <p class="mt-5 text-sm leading-relaxed text-paper/65">DefendableCloud provides proof-of-execution, receipt, dataset catalog, and compute workflow tooling. Customers remain responsible for lawful use of uploaded evidence, generated outputs, datasets, and model workflows. Enterprise terms are contract-specific.</p>
    <p class="mt-4 text-xs uppercase tracking-widest text-paper/35">Launch terms placeholder · replace with counsel-approved terms before enterprise contracts.</p>
  </main>
  <Footer />
</Layout>
