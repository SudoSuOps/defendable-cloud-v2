---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="DPA · DefendableCloud" description="DefendableCloud data processing posture." path="/legal/dpa">
  <Nav />
  <main class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm font-medium uppercase tracking-widest text-honey-300">Legal</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-paper">Data Processing Addendum</h1>
    <p class="mt-5 text-sm leading-relaxed text-paper/65">Enterprise DPA terms are available during contracting. The operating posture is data minimization, customer-controlled evidence, redacted public receipts, access logging, and provider-scoped subprocessors.</p>
    <p class="mt-4 text-xs uppercase tracking-widest text-paper/35">DPA placeholder · replace with counsel-approved DPA before regulated enterprise use.</p>
  </main>
  <Footer />
</Layout>
