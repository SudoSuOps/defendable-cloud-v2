---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Trust Center · DefendableCloud"
  description="DefendableCloud trust center covering receipt integrity, access controls, operational runbooks, security posture, and enterprise readiness."
  path="/trust"
>
  <Nav />
  <main class="mx-auto max-w-4xl px-6 py-20">
    <p class="text-sm font-medium uppercase tracking-widest text-honey-300">Trust Center</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-paper">Proof, access, operations, and accountability.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-paper/70">
      DefendableCloud is the hosted proof vault for agentic work. The trust model is direct:
      verify the work, keep the evidence, hash the receipt, and control who can act.
    </p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {[
        ["Proof integrity", "Hash-chained receipts, parent hashes, JSON/PDF exports, and public verification links."],
        ["Access control", "Magic-link users, hashed API keys, owner/member RBAC, admin allowlists, and internal-key surfaces."],
        ["Dataset governance", "Members-only access, rolling quotas, private staging, redacted public receipts, and signed URLs."],
        ["Operations", "Incident runbook, backup/restore drill, secrets rotation protocol, CI gates, and WAF baseline."],
      ].map(([title, body]) => (
        <section class="rounded-xl border border-white/8 bg-white/[0.02] p-6">
          <h2 class="text-lg font-semibold text-paper">{title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-paper/65">{body}</p>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
