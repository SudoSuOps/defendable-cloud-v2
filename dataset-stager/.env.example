## DefendableCloud dataset stager · private operator env
## Copy to .env on the private staging host and chmod 600.

# Same value as the Fly API's INTERNAL_API_KEY secret.
INTERNAL_API_KEY=replace-me

# Public API base (don't trail with /).
STAGER_API_BASE=https://api.defendablecloud.com

# Private mounted dataset root. Keep the real path out of the public repo.
STAGER_SOURCE_ROOT=/path/to/private/dataset-root

# Tigris bucket + endpoint. Bucket must match the API's TIGRIS_BUCKET secret.
TIGRIS_BUCKET=defendable-cloud-v2
TIGRIS_ENDPOINT_URL=https://fly.storage.tigris.dev

# Tigris S3 credentials (read+write on the bucket). boto3 reads these.
AWS_ACCESS_KEY_ID=tigris-access-key
AWS_SECRET_ACCESS_KEY=tigris-secret-access-key
AWS_REGION=auto

# Set to 1 to plan a run without uploading or notifying.
STAGER_DRY_RUN=0
