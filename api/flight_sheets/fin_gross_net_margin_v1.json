    "deterministic_checks": [
      {
        "description": "Must have exactly 3 calculations (gross_profit, gross_margin, net_margin)",
        "condition": "calculations.length == 3",
        "pass_on_true": true
      },
      {
        "description": "All calculation results must be numeric",
        "condition": "all calc in calculations have typeof calc.result == \"number\"",
        "pass_on_true": true
      },
      {
        "description": "Revenue must not be zero or negative",
        "condition": "revenue > 0",
        "pass_on_true": true
      },
      {
        "description": "Gross profit must equal revenue minus COGS",
        "condition": "abs(calculations[0].result - (revenue - cogs)) < 0.01",
        "pass_on_true": true
      },
      {
        "description": "Gross margin must equal (gross_profit / revenue) * 100",
        "condition": "abs(calculations[1].result - ((revenue - cogs) / revenue * 100)) < 0.01",
        "pass_on_true": true
      },
      {
        "description": "Net margin must equal (net_income / revenue) * 100",
        "condition": "abs(calculations[2].result - (net_income / revenue * 100)) < 0.01",
        "pass_on_true": true
      }
    ],
    "math_checks": [
