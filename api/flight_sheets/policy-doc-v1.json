{
  "slug": "policy-doc-v1",
  "name": "Policy Document Eval",
  "version": "1.0",
  "lane": "other",
  "summary": "Scope/owner defined, conflicts flagged.",
  "purpose": "Evaluate a policy document: defined scope/owner, flagged conflicts.",
  "assignment_instructions": "Draft a policy document for the described area. Use only the provided evidence unless explicitly allowed to assume; label every assumption; if a required input is missing, say so; do not fabricate facts or cite evidence that was not provided.",
  "required_inputs": [
    "policy_brief"
  ],
  "expected_outputs": [
    "scope",
    "owner",
    "policy",
    "exceptions"
  ],
  "audit_checks": [
    {
      "key": "sections_present",
      "label": "Required sections present",
      "category": "structure",
      "kind": "auto",
      "severity": "critical"
    },
    {
      "key": "output_nonempty",
      "label": "Output is substantive",
      "category": "structure",
      "kind": "auto",
      "severity": "noncritical"
    },
    {
      "key": "scope_owner_defined",
      "label": "Scope and owner defined",
      "category": "policy",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "conflicts_flagged",
      "label": "Conflicts flagged",
      "category": "policy",
      "kind": "checklist",
      "severity": "noncritical"
    }
  ],
  "pass_threshold": 80,
  "fail_threshold": 60
}
