{
  "slug": "incident-report-v1",
  "name": "Incident Report Eval",
  "version": "1.0",
  "lane": "other",
  "summary": "Timeline reconciles, facts sourced, cause supported.",
  "purpose": "Evaluate an incident report: reconciled timeline, sourced facts, supported root cause.",
  "assignment_instructions": "Write an incident report from the provided logs and notes. Use only the provided evidence unless explicitly allowed to assume; label every assumption; if a required input is missing, say so; do not fabricate facts or cite evidence that was not provided.",
  "required_inputs": [
    "logs",
    "notes"
  ],
  "expected_outputs": [
    "timeline",
    "impact",
    "root cause",
    "remediation"
  ],
  "audit_checks": [
    {
      "key": "sections_present",
      "label": "Required sections present",
      "category": "structure",
      "kind": "auto",
      "severity": "critical"
    },
    {
      "key": "output_nonempty",
      "label": "Output is substantive",
      "category": "structure",
      "kind": "auto",
      "severity": "noncritical"
    },
    {
      "key": "timeline_reconciles",
      "label": "Timeline reconciles to the logs",
      "category": "math",
      "kind": "checklist",
      "severity": "noncritical"
    },
    {
      "key": "facts_sourced",
      "label": "Facts sourced",
      "category": "evidence",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "root_cause_supported",
      "label": "Root cause supported",
      "category": "policy",
      "kind": "checklist",
      "severity": "noncritical"
    }
  ],
  "pass_threshold": 80,
  "fail_threshold": 60
}
