{
  "slug": "fraud-flag-review-v1",
  "name": "Fraud Flag Review Eval",
  "version": "1.0",
  "lane": "agent",
  "summary": "Did the agent enumerate red flags without overclaiming?",
  "purpose": "Evaluate fraud review: enumerated red flags, no overclaim, escalation noted.",
  "assignment_instructions": "Review the file for fraud indicators and recommend an escalation path. Use only the provided evidence unless explicitly allowed to assume; label every assumption; if a required input is missing, say so; do not fabricate facts or cite evidence that was not provided.",
  "required_inputs": [
    "case_file"
  ],
  "expected_outputs": [
    "red flags",
    "severity",
    "escalation"
  ],
  "audit_checks": [
    {
      "key": "sections_present",
      "label": "Required sections present",
      "category": "structure",
      "kind": "auto",
      "severity": "critical"
    },
    {
      "key": "citations_present",
      "label": "Evidence is referenced",
      "category": "evidence",
      "kind": "auto",
      "severity": "noncritical"
    },
    {
      "key": "red_flags_enumerated",
      "label": "Red flags enumerated against evidence",
      "category": "policy",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "no_overclaim",
      "label": "No overclaim beyond the evidence",
      "category": "evidence",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "escalation_noted",
      "label": "Escalation path noted",
      "category": "authority",
      "kind": "checklist",
      "severity": "noncritical"
    }
  ],
  "pass_threshold": 80,
  "fail_threshold": 60
}
