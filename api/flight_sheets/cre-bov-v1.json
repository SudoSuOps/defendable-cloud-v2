{
  "slug": "cre-bov-v1",
  "name": "CRE Broker Opinion of Value Eval",
  "version": "1.0",
  "lane": "agent",
  "summary": "Is the value range supported and the method disclosed?",
  "purpose": "Evaluate a BOV: supported value range, disclosed method, cited comps.",
  "assignment_instructions": "Produce a broker opinion of value with a supported range. Use only the provided evidence unless explicitly allowed to assume; label every assumption; if a required input is missing, say so; do not fabricate facts or cite evidence that was not provided.",
  "required_inputs": [
    "subject_details",
    "comp_set"
  ],
  "expected_outputs": [
    "value range",
    "method",
    "comps",
    "caveats"
  ],
  "audit_checks": [
    {
      "key": "sections_present",
      "label": "Required sections present",
      "category": "structure",
      "kind": "auto",
      "severity": "critical"
    },
    {
      "key": "citations_present",
      "label": "Evidence is referenced",
      "category": "evidence",
      "kind": "auto",
      "severity": "noncritical"
    },
    {
      "key": "range_supported",
      "label": "Value range supported by analysis",
      "category": "math",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "method_disclosed",
      "label": "Valuation method disclosed",
      "category": "policy",
      "kind": "checklist",
      "severity": "noncritical"
    },
    {
      "key": "comps_cited",
      "label": "Comps cited",
      "category": "evidence",
      "kind": "checklist",
      "severity": "critical"
    }
  ],
  "pass_threshold": 80,
  "fail_threshold": 60
}
