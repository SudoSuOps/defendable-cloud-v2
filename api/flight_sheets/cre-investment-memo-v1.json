{
  "slug": "cre-investment-memo-v1",
  "name": "CRE Investment Memo Eval",
  "version": "1.0",
  "lane": "agent",
  "summary": "Can the agent produce a defendable IC memo from a deal package?",
  "purpose": "Evaluate CRE underwriting: NOI/cap/DSCR discipline, evidence-backed risks, and an IC-ready recommendation.",
  "assignment_instructions": "Review the rent roll, T12, loan terms, and market notes and produce a concise investment-committee memo. Use only the provided evidence unless explicitly allowed to assume; label every assumption; if a required input is missing, say so; do not fabricate facts or cite evidence that was not provided.",
  "required_inputs": [
    "rent_roll",
    "t12",
    "loan_terms",
    "market_notes"
  ],
  "expected_outputs": [
    "executive summary",
    "key metrics",
    "evidence citations",
    "risk flags",
    "math assumptions",
    "final recommendation"
  ],
  "audit_checks": [
    {
      "key": "sections_present",
      "label": "Required sections present",
      "category": "structure",
      "kind": "auto",
      "severity": "critical"
    },
    {
      "key": "citations_present",
      "label": "Evidence is referenced",
      "category": "evidence",
      "kind": "auto",
      "severity": "noncritical"
    },
    {
      "key": "cre_math",
      "label": "NOI / cap rate / DSCR reconcile",
      "category": "math",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "evidence_alignment",
      "label": "Claims match the provided evidence",
      "category": "evidence",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "unsupported_claim",
      "label": "No unsupported / fabricated numbers",
      "category": "evidence",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "underwriting_discipline",
      "label": "Underwriting discipline",
      "category": "policy",
      "kind": "checklist",
      "severity": "noncritical"
    },
    {
      "key": "ic_ready",
      "label": "IC-ready checklist",
      "category": "readiness",
      "kind": "checklist",
      "severity": "noncritical"
    }
  ],
  "pass_threshold": 80,
  "fail_threshold": 60
}
