{
  "slug": "itad-intake-v1",
  "name": "ITAD Intake Eval",
  "version": "1.0",
  "lane": "compute",
  "summary": "Asset identity, data-wipe state, disposition verdict.",
  "purpose": "Evaluate ITAD intake: captured asset identity, data-wipe state, disposition verdict.",
  "assignment_instructions": "Process the IT asset disposition intake and issue a disposition verdict. Use only the provided evidence unless explicitly allowed to assume; label every assumption; if a required input is missing, say so; do not fabricate facts or cite evidence that was not provided.",
  "required_inputs": [
    "asset_info",
    "wipe_log"
  ],
  "expected_outputs": [
    "asset identity",
    "data-wipe state",
    "disposition verdict"
  ],
  "audit_checks": [
    {
      "key": "sections_present",
      "label": "Required sections present",
      "category": "structure",
      "kind": "auto",
      "severity": "critical"
    },
    {
      "key": "specs_present",
      "label": "Specs quantified",
      "category": "structure",
      "kind": "auto",
      "severity": "noncritical"
    },
    {
      "key": "asset_identity",
      "label": "Asset identity captured",
      "category": "evidence",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "wipe_state",
      "label": "Data-wipe state confirmed",
      "category": "policy",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "disposition_verdict",
      "label": "Disposition verdict supported",
      "category": "readiness",
      "kind": "checklist",
      "severity": "noncritical"
    }
  ],
  "pass_threshold": 80,
  "fail_threshold": 60
}
