{
  "slug": "dataset-quality-general-v1",
  "name": "Dataset Quality Eval",
  "version": "1.0",
  "lane": "dataset",
  "summary": "Schema, dedup, provenance, and a supported training verdict.",
  "purpose": "Evaluate dataset triage: schema validity, dedup reasoning, provenance, training-grade verdict.",
  "assignment_instructions": "Inspect the dataset sample for structure, provenance, quality, and risk. Use only the provided evidence unless explicitly allowed to assume; label every assumption; if a required input is missing, say so; do not fabricate facts or cite evidence that was not provided.",
  "required_inputs": [
    "dataset_sample",
    "source_notes"
  ],
  "expected_outputs": [
    "schema assessment",
    "dedup rate",
    "provenance",
    "risk flags",
    "training verdict"
  ],
  "audit_checks": [
    {
      "key": "sections_present",
      "label": "Required sections present",
      "category": "structure",
      "kind": "auto",
      "severity": "critical"
    },
    {
      "key": "output_nonempty",
      "label": "Output is substantive",
      "category": "structure",
      "kind": "auto",
      "severity": "noncritical"
    },
    {
      "key": "schema_valid",
      "label": "Schema validity assessed",
      "category": "schema",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "dedup_reasoning",
      "label": "Dedup / count reasoning shown",
      "category": "math",
      "kind": "checklist",
      "severity": "noncritical"
    },
    {
      "key": "provenance",
      "label": "Provenance established",
      "category": "evidence",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "training_verdict",
      "label": "Training-grade verdict supported",
      "category": "readiness",
      "kind": "checklist",
      "severity": "noncritical"
    }
  ],
  "pass_threshold": 80,
  "fail_threshold": 60
}
