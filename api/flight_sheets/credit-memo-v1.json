{
  "slug": "credit-memo-v1",
  "name": "Credit Memo Eval",
  "version": "1.0",
  "lane": "agent",
  "summary": "Does the credit memo cover the 5 Cs with reconciled ratios?",
  "purpose": "Evaluate a credit memo: 5C analysis, reconciled ratios, flagged risks, sourced figures.",
  "assignment_instructions": "Produce a credit memo analyzing the borrower and the request. Use only the provided evidence unless explicitly allowed to assume; label every assumption; if a required input is missing, say so; do not fabricate facts or cite evidence that was not provided.",
  "required_inputs": [
    "financials",
    "application"
  ],
  "expected_outputs": [
    "borrower summary",
    "5C analysis",
    "ratios",
    "risks",
    "recommendation"
  ],
  "audit_checks": [
    {
      "key": "sections_present",
      "label": "Required sections present",
      "category": "structure",
      "kind": "auto",
      "severity": "critical"
    },
    {
      "key": "citations_present",
      "label": "Evidence is referenced",
      "category": "evidence",
      "kind": "auto",
      "severity": "noncritical"
    },
    {
      "key": "five_c",
      "label": "5C analysis present",
      "category": "policy",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "ratios_reconcile",
      "label": "Ratios reconcile to financials",
      "category": "math",
      "kind": "checklist",
      "severity": "critical"
    },
    {
      "key": "risks_flagged",
      "label": "Risks flagged",
      "category": "policy",
      "kind": "checklist",
      "severity": "noncritical"
    },
    {
      "key": "sourced",
      "label": "Figures sourced",
      "category": "evidence",
      "kind": "checklist",
      "severity": "critical"
    }
  ],
  "pass_threshold": 80,
  "fail_threshold": 60
}
