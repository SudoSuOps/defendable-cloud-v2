      {
        "flag_id": "zero_total_capital",
        "condition": "total_capital == 0",
        "severity": "honey",
        "message": "Total capital is zero \u2014 WACC is undefined"
      },
      {
        "flag_id": "false_pass_invalid",
        "condition": "final_output == \"PASS\" AND (tax_rate < 0 OR tax_rate > 1 OR total_capital == 0)",
        "severity": "propolis",
        "message": "final_output is PASS but inputs are invalid"
      }
    ],
    "rules": []
  }
