      },
      {
        "formula_id": "wacc_formula",
        "description": "WACC = (E/V * Ke) + (D/V * Kd_after_tax)",
        "formula": "wacc = (weight_of_equity * cost_of_equity) + (weight_of_debt * after_tax_cost_of_debt)",
        "expected_precision": 0.0001,
        "variables": [
          {
            "name": "weight_of_equity",
            "type": "number"
          },
          {
            "name": "cost_of_equity",
            "type": "number"
          },
          {
            "name": "weight_of_debt",
            "type": "number"
          },
          {
            "name": "after_tax_cost_of_debt",
            "type": "number"
          }
        ],
