        "severity": "propolis",
        "message": "Total capital does not equal equity plus debt"
      },
      {
        "flag_id": "weights_sum_error",
        "condition": "abs(weight_equity + weight_debt - 1.0) >= 0.001",
        "severity": "propolis",
        "message": "Weights of equity and debt do not sum to 1.0"
      },
      {
        "flag_id": "after_tax_cost_mismatch",
        "condition": "abs(after_tax_cost_calc - (cost_of_debt * (1 - tax_rate))) >= 0.0001",
        "severity": "propolis",
        "message": "After-tax cost of debt calculation is incorrect"
      },
      {
        "flag_id": "wacc_mismatch",
        "condition": "abs(wacc_calc - ((weight_equity * cost_of_equity) + (weight_debt * after_tax_cost_calc))) >= 0.0001",
        "severity": "propolis",
        "message": "WACC calculation does not match the formula"
      },
      {
        "flag_id": "invalid_tax_rate",
