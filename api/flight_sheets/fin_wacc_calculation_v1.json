    "deterministic_checks": [
      {
        "description": "Must have exactly 5 calculations",
        "condition": "calculations.length == 5",
        "pass_on_true": true
      },
      {
        "description": "All calculation results must be numeric",
        "condition": "all calc in calculations have typeof calc.result == \"number\"",
        "pass_on_true": true
      },
      {
        "description": "total_capital must equal total_equity + total_debt",
        "condition": "abs(total_capital_result - (total_equity + total_debt)) < 0.01",
        "pass_on_true": true
      },
      {
        "description": "Weights must sum to 1.0",
        "condition": "abs(weight_of_equity_result + weight_of_debt_result - 1.0) < 0.001",
        "pass_on_true": true
      },
      {
        "description": "after_tax_cost_of_debt must equal cost_of_debt * (1 - tax_rate)",
        "condition": "abs(after_tax_cost_of_debt_result - (cost_of_debt * (1 - tax_rate))) < 0.0001",
        "pass_on_true": true
      },
      {
        "description": "WACC must equal (E/V * Ke) + (D/V * Kd_after_tax)",
        "condition": "abs(wacc_result - ((weight_of_equity_result * cost_of_equity) + (weight_of_debt_result * after_tax_cost_of_debt_result))) < 0.0001",
        "pass_on_true": true
      },
      {
        "description": "Tax rate must be between 0 and 1",
        "condition": "tax_rate >= 0 AND tax_rate <= 1",
        "pass_on_true": true
      }
    ],
    "math_checks": [
      {
        "formula_id": "total_capital_formula",
        "description": "Total Capital = Total Equity + Total Debt",
        "formula": "total_capital = total_equity + total_debt",
        "expected_precision": 0.01,
        "variables": [
          {
            "name": "total_equity",
            "type": "number"
          },
          {
            "name": "total_debt",
            "type": "number"
          }
        ],
        "result_field": "calculations[?name=='total_capital'].result"
      },
      {
        "formula_id": "weight_equity_formula",
        "description": "Weight of Equity = Total Equity / Total Capital",
        "formula": "weight_of_equity = total_equity / total_capital",
        "expected_precision": 0.001,
        "variables": [
          {
            "name": "total_equity",
            "type": "number"
          },
          {
            "name": "total_capital",
            "type": "number"
          }
        ],
        "result_field": "calculations[?name=='weight_of_equity'].result"
      },
      {
        "formula_id": "weight_debt_formula",
        "description": "Weight of Debt = Total Debt / Total Capital",
        "formula": "weight_of_debt = total_debt / total_capital",
        "expected_precision": 0.001,
        "variables": [
          {
            "name": "total_debt",
            "type": "number"
          },
          {
            "name": "total_capital",
            "type": "number"
          }
        ],
        "result_field": "calculations[?name=='weight_of_debt'].result"
      },
      {
        "formula_id": "after_tax_cost_debt_formula",
        "description": "After-Tax Cost of Debt = Cost of Debt * (1 - Tax Rate)",
        "formula": "after_tax_cost_of_debt = cost_of_debt * (1 - tax_rate)",
        "expected_precision": 0.0001,
        "variables": [
          {
            "name": "cost_of_debt",
            "type": "number"
          },
          {
            "name": "tax_rate",
            "type": "number"
          }
