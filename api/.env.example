# DefendableCloud API — local/dev environment
APP_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080

# Postgres (asyncpg)
DATABASE_URL=postgresql+asyncpg://defendable:defendable@localhost:5432/defendable_cloud

# Tigris / S3-compatible object storage
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
TIGRIS_BUCKET=defendable-cloud

# Auth
JWT_SECRET=dev-insecure-change-me
JWT_TTL_HOURS=720
MAGIC_TTL_MINUTES=30

# Email (Resend) — leave blank in dev to print magic links to the response/log
RESEND_API_KEY=
EMAIL_FROM=DefendableCloud <build@defendableos.com>

# CORS (comma-separated; blank = *)
CORS_ORIGINS=
